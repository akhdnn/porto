---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets'; // Import Image dari Astro Assets

import RevealCard from '../components/RevealCard.jsx';
import StickerCard from '../components/StickerCard.jsx';
import FlameAnimated from '../components/FlameAnimated';

import rafiePhoto from '../assets/pijen.jpg';
import gerdaPhoto from '../assets/gerda.jpg';
import raffiPhoto from '../assets/raffi.jpg';

import heroSumbu1 from '../assets/hero_sumbu_1.png';
import heroSumbu2 from '../assets/hero_sumbu_2.png';
import heroSumbu3 from '../assets/hero_sumbu_3.png';
import icon1 from '../assets/hero_sumbu_2-1.png';
import icon2 from '../assets/hero_sumbu_2-2.png';
import icon3 from '../assets/hero_sumbu_2-3.png';
import icon4 from '../assets/hero_sumbu_2-4.png';

import sumbuJobMockup from '../assets/sumbu_job_mockup.png';
import sumbuInterviewMockup from '../assets/sumbu_interview_mockup.png';
import sumbuTrainingMockup from '../assets/sumbu_training_mockup.png';

import dsTypography from '../assets/ds_typography.png';
import dsIcons from '../assets/ds_icons.png';
import dsColors from '../assets/ds_colors.png';
import dsElements from '../assets/ds_elements.png';

const articleNavLinks = [
    { href: '#problem', label: 'The Problem' },
    { href: '#process', label: 'My Design Process' },
    { href: '#solution', label: 'Solution & Implementation' },
    { href: '#reflection', label: 'Results & Learnings' },
];

// Array Stiker
const myStickers = [icon1, icon2, icon3, icon4];
---

<Layout 
    title="Sumbu | Job access for all"
    description="An integrated platform for job searching, skills training, and AI-based interviews, specializing in low-requirement and part-time jobs."
>
    <div class="max-w-screen-xl mx-auto flex gap-8 px-4">
        <aside class="hidden md:block w-64 sticky top-24 self-start py-8">
            <a href="/" class="inline-flex items-center gap-2 text-gray-500 hover:text-gray-900 mb-8 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                <span>Back to Home</span>
            </a>
            <nav>
                <ul class="space-y-3">
                    {articleNavLinks.map(link => (
                        <li>
                            <a 
                                href={link.href} 
                                data-navlink={link.href.substring(1)}
                                class="article-nav-link text-gray-500 hover:text-gray-900 transition-colors"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </aside>

        <main class="w-full md:flex-1 font-sans text-gray-800">
            <div class="max-w-4xl mx-auto pt-24 md:pt-32 pb-16 md:pb-24">
                        
                <div class="mb-12 mt-12 grid grid-cols-3 grid-rows-2 gap-4 md:gap-6 h-[300px] md:h-[500px]">
                    <div class="col-span-1 row-span-1">
                        <StickerCard 
                            mainImage={heroSumbu2} 
                            stickers={myStickers} 
                            imageClass="w-2/3 h-auto"
                            client:load 
                        />
                    </div>
                    <div class="col-span-2 row-span-1 bg-[#F0F2F6] rounded-2xl overflow-hidden relative group">
                        <Image 
                            src={heroSumbu3} 
                            alt="Sumbu Feature Preview" 
                            loading="eager"
                            fetchpriority="high"
                            class="w-full h-full object-cover scale-110 transition-transform duration-700 group-hover:scale-100" 
                        />
                    </div>
                    <div class="col-span-2 row-span-1">
                        <RevealCard 
                            image={heroSumbu1} 
                            title="Sumbu Job Application Flow"
                            startPositionClass='translate-y-40'
                            endPositionClass="group-hover:translate-y-20"
                            imageClass="h-[600px] w-auto"
                            client:load 
                        />
                    </div>
                    <div class="group col-span-1 row-span-1 bg-[#F0F2F6] p-4 rounded-2xl overflow-hidden flex items-center justify-center">
                        <FlameAnimated size={150} />
                    </div>
                </div>

                <div class="mb-8">
                    <h1 class="text-4xl md:text-6xl font-bold text-gray-900">Sumbu</h1>
                    <p class="mt-2 text-xl md:text-2xl text-gray-500">An all-in-one platform for accessible jobs and skills training</p>
                </div>

                <div class="border-t border-gray-200 pt-8">
                    <div class="grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-x-12 gap-y-8 mb-16">
                        <div class="space-y-8">
                            <div>
                                <h3 class="text-sm font-semibold text-gray-500 tracking-wider uppercase">MY ROLE</h3>
                                <p class="mt-2 text-lg text-gray-800">UI Designer</p>
                            </div>
                            <div>
                                <h3 class="text-sm font-semibold text-gray-500 tracking-wider uppercase">TEAMMATE</h3>
                                <div class="flex items-center mt-4 -space-x-2">

                                    <a href="https://www.linkedin.com/in/rafie-zein/" target="_blank" rel="noopener noreferrer" class="relative group">
                                        <Image 
                                            src={rafiePhoto} 
                                            alt="Rafie Ramadhan Al Aziz Zein"
                                            class="h-12 w-12 rounded-full object-cover border-2 border-white transition duration-300 group-hover:scale-110"
                                        />
                                        <div class="absolute bottom-full mb-2 w-max bg-black text-white text-center rounded-lg px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style="left: 50%; transform: translateX(-50%);">
                                            <p class="font-semibold text-sm">Rafie Ramadhan Al Aziz Zein</p>
                                            <p class="text-xs">UX Researcher</p>
                                        </div>
                                    </a>

                                    <a href="https://www.linkedin.com/in/gerdakalista/" target="_blank" rel="noopener noreferrer" class="relative group">
                                        <Image 
                                            src={gerdaPhoto} 
                                            alt="Gerda Kalista"
                                            class="h-12 w-12 rounded-full object-cover border-2 border-white transition duration-300 group-hover:scale-110"
                                        />
                                        <div class="absolute bottom-full mb-2 w-max bg-black text-white text-center rounded-lg px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style="left: 50%; transform: translateX(-50%);">
                                            <p class="font-semibold text-sm">Gerda Kalista</p>
                                            <p class="text-xs">UX Researcher</p>
                                        </div>
                                    </a>

                                    <a href="https://www.linkedin.com/in/muhamadraffi/" target="_blank" rel="noopener noreferrer" class="relative group">
                                        <Image 
                                            src={raffiPhoto} 
                                            alt="Muhamad Raffi"
                                            class="h-12 w-12 rounded-full object-cover border-2 border-white transition duration-300 group-hover:scale-110"
                                        />
                                        <div class="absolute bottom-full mb-2 w-max bg-black text-white text-center rounded-lg px-3 py-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style="left: 50%; transform: translateX(-50%);">
                                            <p class="font-semibold text-sm">Muhamad Raffi</p>
                                            <p class="text-xs">UX Designer</p>
                                        </div>
                                </a>

                                </div>
                            </div>
                            <div>
                                <h3 class="text-sm font-semibold text-gray-500 tracking-wider uppercase">TOOLS</h3>
                                <p class="mt-2 text-lg text-gray-800">Figma</p>
                            </div>
                            <div>
                                <h3 class="text-sm font-semibold text-gray-500 tracking-wider uppercase">TIMELINE</h3>
                                <p class="mt-2 text-lg text-gray-800">2025</p>
                            </div>
                        </div>
                        <div class="space-y-8">
                            <div>
                                <h3 class="text-sm font-semibold text-gray-500 tracking-wider uppercase">DESCRIPTION</h3>
                                <p class="mt-2 text-lg text-gray-700 leading-relaxed">
                                    Sumbu is a web platform that connects young job seekers with MSMEs and training institutions through simplified job applications, skill training, and AI-based interview practice.
                                </p>
                            </div>
                            <div>
                                <h3 class="text-sm font-semibold text-gray-500 tracking-wider uppercase">CONTEXT</h3>
                                <p class="mt-2 text-lg text-gray-700 leading-relaxed">
                                    Youth unemployment remains a major issue in Indonesia, especially among junior and senior high school graduates. Many young job seekers lack work-ready skills and confidence, while MSMEs rely on slow and manual recruitment processes. Sumbu was designed to bridge this gap by integrating job access, training, and interview preparation in one platform.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div>
                        
                        <section id="problem" class="border-t border-gray-200 mt-20 md:mt-32 pt-20 md:pt-32">
                            <div class="mb-10">
                                <h2 class="text-3xl font-bold text-gray-900">The Problem</h2>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 mb-12 text-lg text-gray-700 leading-relaxed">
                                <div>
                                    <h3 class="font-bold text-gray-900 mb-4 text-xl">The Job Seeker's Struggle</h3>
                                    <p>
                                        Young job seekers face complex job requirements and feel unprepared during interviews. Many lack clear direction to improve their skills and confidence.
                                    </p>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900 mb-4 text-xl">The MSME's Bottleneck</h3>
                                    <p>
                                        At the same time, MSMEs need work-ready candidates but are constrained by inefficient hiring processes. This creates friction for both sides and slows access to employment opportunities.
                                    </p>
                                </div>
                            </div>

                            <div class="bg-[#F0F2F6] rounded-3xl p-8 md:p-12 mb-8">
                                <h3 class="text-2xl font-bold text-gray-900 mb-8">Problem Context Data</h3>
                                
                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
                                    
                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center gap-3">
                                           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" color="currentColor" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M15.5 11C15.5 9.067 13.933 7.5 12 7.5C10.067 7.5 8.5 9.067 8.5 11C8.5 12.933 10.067 14.5 12 14.5C13.933 14.5 15.5 12.933 15.5 11Z" />
                                                <path d="M15.4827 11.3499C15.8047 11.4475 16.1462 11.5 16.5 11.5C18.433 11.5 20 9.933 20 8C20 6.067 18.433 4.5 16.5 4.5C14.6851 4.5 13.1928 5.8814 13.0173 7.65013" />
                                                <path d="M10.9827 7.65013C10.8072 5.8814 9.31492 4.5 7.5 4.5C5.567 4.5 4 6.067 4 8C4 9.933 5.567 11.5 7.5 11.5C7.85381 11.5 8.19535 11.4475 8.51727 11.3499" />
                                                <path d="M22 16.5C22 13.7386 19.5376 11.5 16.5 11.5" />
                                                <path d="M17.5 19.5C17.5 16.7386 15.0376 14.5 12 14.5C8.96243 14.5 6.5 16.7386 6.5 19.5" />
                                                <path d="M7.5 11.5C4.46243 11.5 2 13.7386 2 16.5" />
                                            </svg>                                   
                                            <strong class="text-gray-900 text-2xl font-bold">22.34%</strong>
                                        </div>
                                        <p class="text-gray-600 leading-relaxed">
                                            Unemployment rate for ages 18–24 reached this critical level.
                                        </p>
                                    </div>

                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center gap-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" color="currentColor" fill="none" stroke="#141B34" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1.99805 7.99928C1.99805 9.34126 10.0943 13 11.9857 13C13.8772 13 21.9734 9.34126 21.9734 7.99928C21.9734 6.6573 13.8772 2.99854 11.9857 2.99854C10.0943 2.99854 1.99805 6.6573 1.99805 7.99928Z" />
                                            <path d="M5.99219 11L7.24348 16.8002C7.32919 17.1975 7.52703 17.5687 7.85696 17.8054C10.0787 19.3998 13.8908 19.3998 16.1126 17.8054C16.4426 17.5687 16.6404 17.1975 16.7261 16.8002L17.9774 11" />
                                            <path d="M20.4774 9.49951V16.5006M20.4774 16.5006C19.6864 17.9471 19.3366 18.7221 18.9813 20.0011C18.9042 20.4562 18.9654 20.6855 19.2786 20.8891C19.4059 20.9718 19.5588 21.0012 19.7104 21.0012H21.229C21.3904 21.0012 21.5533 20.9675 21.6863 20.8757C21.9774 20.6747 22.0523 20.4541 21.9734 20.0011C21.662 18.8135 21.2653 18.0016 20.4774 16.5006Z" />
                                        </svg>                                   
                                        <strong class="text-gray-900 text-2xl font-bold">7 out of 10</strong>
                                        </div>
                                        <p class="text-gray-600 leading-relaxed">
                                            Unemployed youth are junior and senior high school graduates.
                                        </p>
                                    </div>

                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center gap-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" color="currentColor" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10" />
                                                <path d="M12 8V12.5" />
                                                <path d="M12 15.9883V15.9983" />
                                            </svg>                                    
                                            <strong class="text-gray-900 text-2xl font-bold">72%</strong>
                                        </div>
                                        <p class="text-gray-600 leading-relaxed">
                                            Of job seekers struggle to find jobs that match their skills.
                                        </p>
                                    </div>

                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center gap-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" color="currentColor" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M8 7L16 7" />
                                                <path d="M8 11L12 11" />
                                                <path d="M13 21.5V21C13 18.1716 13 16.7574 13.8787 15.8787C14.7574 15 16.1716 15 19 15H19.5M20 13.3431V10C20 6.22876 20 4.34315 18.8284 3.17157C17.6569 2 15.7712 2 12 2C8.22877 2 6.34315 2 5.17157 3.17157C4 4.34314 4 6.22876 4 10L4 14.5442C4 17.7892 4 19.4117 4.88607 20.5107C5.06508 20.7327 5.26731 20.9349 5.48933 21.1139C6.58831 22 8.21082 22 11.4558 22C12.1614 22 12.5141 22 12.8372 21.886C12.9044 21.8623 12.9702 21.835 13.0345 21.8043C13.3436 21.6564 13.593 21.407 14.0919 20.9081L18.8284 16.1716C19.4065 15.5935 19.6955 15.3045 19.8478 14.9369C20 14.5694 20 14.1606 20 13.3431Z" />
                                            </svg>
                                            <strong class="text-gray-900 text-2xl font-bold">60%</strong>
                                        </div>
                                        <p class="text-gray-600 leading-relaxed">
                                            Do not know where to start learning new skills.
                                        </p>
                                    </div>

                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center gap-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" color="currentColor" fill="none" stroke="#141B34" stroke-width="2">
                                                <path d="M3.00006 10.9866V15.4932C3.00006 18.3257 3.00006 19.742 3.87874 20.622C4.75742 21.502 6.17163 21.502 9.00006 21.502H15.0001C17.8285 21.502 19.2427 21.502 20.1214 20.622C21.0001 19.742 21.0001 18.3257 21.0001 15.4932V10.9866" />
                                                <path d="M7.00006 17.9741H11.0001" />
                                                <path d="M17.7957 2.50049L6.14989 2.52954C4.41172 2.44011 3.96606 3.77859 3.96606 4.4329C3.96606 5.01809 3.89061 5.8712 2.8253 7.47462C1.75999 9.07804 1.84004 9.55437 2.44077 10.6644C2.93934 11.5857 4.20747 11.9455 4.86868 12.0061C6.96889 12.0538 7.99072 10.2398 7.99072 8.96495C9.03257 12.1683 11.9956 12.1683 13.3159 11.802C14.6386 11.435 15.7718 10.1214 16.0391 8.96495C16.1951 10.4021 16.6682 11.2408 18.0663 11.817C19.5145 12.4139 20.76 11.5016 21.3848 10.9168C22.0097 10.332 22.4107 9.03364 21.2968 7.60666C20.5286 6.62257 20.2085 5.69548 20.1033 4.73462C20.0424 4.17787 19.9888 3.57961 19.5972 3.1989C19.0248 2.64253 18.2036 2.47372 17.7957 2.50049Z" />
                                            </svg>   
                                            <strong class="text-gray-900 text-2xl font-bold">48%</strong>
                                        </div>
                                        <p class="text-gray-600 leading-relaxed">
                                            Of MSMEs struggle to find work-ready candidates.
                                        </p>
                                    </div>

                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center gap-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" color="currentColor" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M8 7L16 7" />
                                                <path d="M8 11L12 11" />
                                                <path d="M13 21.5V21C13 18.1716 13 16.7574 13.8787 15.8787C14.7574 15 16.1716 15 19 15H19.5M20 13.3431V10C20 6.22876 20 4.34315 18.8284 3.17157C17.6569 2 15.7712 2 12 2C8.22877 2 6.34315 2 5.17157 3.17157C4 4.34314 4 6.22876 4 10L4 14.5442C4 17.7892 4 19.4117 4.88607 20.5107C5.06508 20.7327 5.26731 20.9349 5.48933 21.1139C6.58831 22 8.21082 22 11.4558 22C12.1614 22 12.5141 22 12.8372 21.886C12.9044 21.8623 12.9702 21.835 13.0345 21.8043C13.3436 21.6564 13.593 21.407 14.0919 20.9081L18.8284 16.1716C19.4065 15.5935 19.6955 15.3045 19.8478 14.9369C20 14.5694 20 14.1606 20 13.3431Z" />
                                            </svg>
                                            <strong class="text-gray-900 text-2xl font-bold">65%</strong>
                                        </div>
                                        <p class="text-gray-600 leading-relaxed">
                                            Of MSMEs still rely on manual recruitment processes.
                                        </p>
                                    </div>

                                </div>
                            </div>

                            <div>
                                <h3 class="font-bold text-gray-900 mb-4 text-xl">Key problems</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    
                                    <div class="bg-[#F0F2F6] p-6 rounded-2xl flex items-center gap-5">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" color="currentColor" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M8 7L16 7" />
                                            <path d="M8 11L12 11" />
                                            <path d="M13 21.5V21C13 18.1716 13 16.7574 13.8787 15.8787C14.7574 15 16.1716 15 19 15H19.5M20 13.3431V10C20 6.22876 20 4.34315 18.8284 3.17157C17.6569 2 15.7712 2 12 2C8.22877 2 6.34315 2 5.17157 3.17157C4 4.34314 4 6.22876 4 10L4 14.5442C4 17.7892 4 19.4117 4.88607 20.5107C5.06508 20.7327 5.26731 20.9349 5.48933 21.1139C6.58831 22 8.21082 22 11.4558 22C12.1614 22 12.5141 22 12.8372 21.886C12.9044 21.8623 12.9702 21.835 13.0345 21.8043C13.3436 21.6564 13.593 21.407 14.0919 20.9081L18.8284 16.1716C19.4065 15.5935 19.6955 15.3045 19.8478 14.9369C20 14.5694 20 14.1606 20 13.3431Z" />
                                        </svg>
                                        <p class="font-semibold text-lg text-gray-900 leading-snug">Complicated job application steps</p>
                                    </div>

                                    <div class="bg-[#F0F2F6] p-6 rounded-2xl flex items-center gap-5">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" color="currentColor" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10" />
                                            <path d="M8.00897 9H8M16 9H15.991" />
                                            <path d="M10 16L15 14" />
                                        </svg>      
                                        <p class="font-semibold text-lg text-gray-900 leading-snug">Low interview confidence</p>
                                    </div>

                                    <div class="bg-[#F0F2F6] p-6 rounded-2xl flex items-center gap-5">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" color="currentColor" fill="none" stroke="#141B34" stroke-width="2">
                                            <path d="M3.00006 10.9866V15.4932C3.00006 18.3257 3.00006 19.742 3.87874 20.622C4.75742 21.502 6.17163 21.502 9.00006 21.502H15.0001C17.8285 21.502 19.2427 21.502 20.1214 20.622C21.0001 19.742 21.0001 18.3257 21.0001 15.4932V10.9866" />
                                            <path d="M7.00006 17.9741H11.0001" />
                                            <path d="M17.7957 2.50049L6.14989 2.52954C4.41172 2.44011 3.96606 3.77859 3.96606 4.4329C3.96606 5.01809 3.89061 5.8712 2.8253 7.47462C1.75999 9.07804 1.84004 9.55437 2.44077 10.6644C2.93934 11.5857 4.20747 11.9455 4.86868 12.0061C6.96889 12.0538 7.99072 10.2398 7.99072 8.96495C9.03257 12.1683 11.9956 12.1683 13.3159 11.802C14.6386 11.435 15.7718 10.1214 16.0391 8.96495C16.1951 10.4021 16.6682 11.2408 18.0663 11.817C19.5145 12.4139 20.76 11.5016 21.3848 10.9168C22.0097 10.332 22.4107 9.03364 21.2968 7.60666C20.5286 6.62257 20.2085 5.69548 20.1033 4.73462C20.0424 4.17787 19.9888 3.57961 19.5972 3.1989C19.0248 2.64253 18.2036 2.47372 17.7957 2.50049Z" />
                                        </svg>  
                                        <p class="font-semibold text-lg text-gray-900 leading-snug">Inefficient MSME recruitment</p>
                                    </div>

                                    <div class="bg-[#F0F2F6] p-6 rounded-2xl flex items-center gap-5">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" color="currentColor" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
